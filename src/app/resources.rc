#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "stage_manager.manifest"
IDI_STAGE_MANAGER ICON "../../assets/windows-stage-manager.ico"

IDD_CUSTOM_SETTING DIALOGEX 0, 0, 228, 82
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "自定义参数"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LTEXT           "", IDC_CUSTOM_SETTING_PROMPT, 10, 9, 208, 24
    EDITTEXT        IDC_CUSTOM_SETTING_VALUE, 10, 36, 208, 14, ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "确定", IDOK, 112, 59, 50, 14
    PUSHBUTTON      "取消", IDCANCEL, 168, 59, 50, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 610, 370
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION "窗口管理器设置"
FONT 9, "Microsoft YaHei UI"
BEGIN
    LISTBOX         IDC_SETTINGS_FIELDS, 10, 10, 170, 320, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_SETTINGS_TITLE, 195, 12, 400, 18
    LTEXT           "", IDC_SETTINGS_DESCRIPTION, 195, 34, 400, 40
    LTEXT           "当前值：", IDC_SETTINGS_CURRENT_LABEL, 195, 82, 58, 14
    COMBOBOX        IDC_SETTINGS_VALUE, 255, 79, 170, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_SETTINGS_UNIT, 195, 101, 400, 32
    CONTROL         "", IDC_SETTINGS_PREVIEW, "STATIC", SS_OWNERDRAW | WS_BORDER, 195, 138, 400, 170
    LTEXT           "提示：绿色区域表示未激活窗口需要保留的可点击边缘。修改数值时预览会同步变化。", IDC_SETTINGS_HINT, 195, 315, 400, 22
    PUSHBUTTON      "恢复默认", IDC_SETTINGS_DEFAULTS, 365, 344, 70, 16
    DEFPUSHBUTTON   "保存并应用", IDOK, 441, 344, 76, 16
    PUSHBUTTON      "取消", IDCANCEL, 523, 344, 70, 16
END
